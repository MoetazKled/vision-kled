# LLM — put at least one key. Default provider is openai.
# Without a key, a local fallback engine still runs the conversation.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# SQLite by default (Phase 0, zero cost). Switch to Postgres when ready:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/visionkled
DATABASE_URL=sqlite:///visionkled.db

DEMO_BASE_URL=http://127.0.0.1:8003
API_HOST=127.0.0.1
API_PORT=8003
